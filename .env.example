# Local development. In production these live in Vercel → Settings →
# Environment Variables. See README.md for the full table and /api/health for
# what the running server can actually read.

# --- Required ------------------------------------------------------------
# Reaches the browser at runtime via the root route's loader.
# Also accepted: VITE_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# Also accepted: VITE_SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                SUPABASE_PUBLISHABLE_KEY, and the VITE_/NEXT_PUBLIC_ variants
SUPABASE_ANON_KEY=

# Server only — never reaches the browser. Writes enquiries, bookings and mail.
# Also accepted: SUPABASE_SECRET_KEY, SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: sending mail ----------------------------------------------
# Unset means notifications are skipped and logged; nothing else breaks.
RESEND_API_KEY=

# One domain drives every address below.
MAIL_DOMAIN=blueprinthavenltd.com
# MAIL_FROM=Blueprint Haven <no-reply@blueprinthavenltd.com>
# MAIL_REPLY_TO=hello@blueprinthavenltd.com
# Where visitor notifications land. Do NOT point this at an address on
# MAIL_DOMAIN that forwards back into /api/inbound-email — mail will loop.
# MAIL_NOTIFY_TO=studio@blueprinthavenltd.com

# --- Optional: receiving mail --------------------------------------------
# The whsec_… signing secret of the Resend inbound route pointed at
# /api/inbound-email. Requires supabase/migrations/0002_email.sql.
RESEND_WEBHOOK_SECRET=
